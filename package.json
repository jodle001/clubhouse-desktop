{
  "name": "clubhouse-desktop",
  "productName": "Clubhouse Desktop",
  "version": "1.0.0",
  "description": "An unofficial Clubhouse desktop client",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "repository": "jodle001/clubhouse-desktop",
  "author": "jodle001",
  "contributors": [
    "Arta Mo <salehmoosapour1377@gmail.com> (original author, https://callmearta.ir)"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite build && electron-vite preview",
    "build": "electron-vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "doctor": "node scripts/doctor.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --macos --linux --windows",
    "dist:linux": "npm run build && electron-builder --linux",
    "preview": "electron-vite preview",
    "predev": "node scripts/ensure-electron.js",
    "prestart": "node scripts/ensure-electron.js",
    "prepack": "node scripts/ensure-electron.js"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "pubnub": "^12.0.2",
    "vue": "^3.5.40",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.0",
    "jsdom": "^28.0.1",
    "vite": "^7.2.7",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "agora-rtc-sdk-ng": "^4.24.6"
  },
  "build": {
    "appId": "com.jodle001.clubhouse-desktop",
    "productName": "Clubhouse Desktop",
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "directories": {
      "buildResources": "resources"
    },
    "mac": {
      "category": "public.app-category.social-networking",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Microphone access is required to speak in rooms."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Network;Chat"
    },
    "win": {
      "target": "nsis"
    }
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.1.1",
    "http-cache-semantics": "^4.2.0",
    "semver": "^7.7.3"
  }
}
